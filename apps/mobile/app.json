{
  "expo": {
    "name": "Gymloop",
    "slug": "gymloop",
    "version": "1.0.0",
    "scheme": "gymloop",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Gymloop to scan the current QR code at your gym.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "ios": {
      "bundleIdentifier": "in.gymloop.mobile"
    },
    "android": {
      "package": "in.gymloop.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3708f347-96ac-4236-a74c-95808210292b"
      }
    },
    "owner": "harsh9887"
  }
}
