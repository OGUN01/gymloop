{
  "expo": {
    "name": "Fitcrux",
    "slug": "gymloop",
    "version": "1.0.0",
    "scheme": "gymloop",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Fitcrux to scan the current QR code at your gym.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#F3F0EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#141311"
          }
        }
      ],
      "expo-web-browser"
    ],
    "ios": {
      "bundleIdentifier": "app.fitcrux"
    },
    "android": {
      "package": "app.fitcrux",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#F3F0EA"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3708f347-96ac-4236-a74c-95808210292b"
      }
    },
    "owner": "harsh9887"
  }
}
