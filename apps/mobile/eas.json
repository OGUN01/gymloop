{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "simulator": {
      "environment": "development",
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      }
    }
  }
}
