{
  "name": "gymloop",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run lint:root",
    "lint:root": "eslint scripts eslint.config.mjs .dependency-cruiser.mjs --no-error-on-unmatched-pattern supabase/functions",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test",
    "test:scripts": "vitest run scripts",
    "knip": "knip",
    "jscpd": "jscpd --exit-code 1",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.mjs apps packages supabase",
    "registry-lint": "node scripts/registry-lint.mjs",
    "generate-renewal-reminder-windows": "node scripts/check-renewal-reminder-windows.mjs --write",
    "check-renewal-reminder-windows": "node scripts/check-renewal-reminder-windows.mjs",
    "check-test-immutability": "node scripts/check-test-immutability.mjs",
    "check-escape-hatches": "node scripts/check-escape-hatches.mjs",
    "check-pgtap-rollback": "node scripts/check-pgtap-rollback.mjs",
    "gates": "bash scripts/gates.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@gymloop/shared": "workspace:*",
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.112.4",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "jscpd": "5.1.2",
    "k6": "0.0.0",
    "knip": "6.34.0",
    "supabase": "2.110.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
